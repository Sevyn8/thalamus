# DIS local environment. Copy to .env (git-ignored): `cp .env.example .env`.
# The Makefile does `include .env`, so the file must exist before any make target.
# Values below match the docker-compose stack; local-only, no real credentials.

# DIS Postgres (docker-compose `postgres`, host port 5433).
# App role (NOSUPERUSER NOBYPASSRLS) — used by all service code and tests.
POSTGRES_URL=postgresql+psycopg://ithina_dis_user:ithina_dis_password@localhost:5433/ithina_dis_db
# Admin role — migrations only (make db-migrate / alembic), never service code.
POSTGRES_ADMIN_URL=postgresql+psycopg://ithina_dis_admin:ithina_dis_admin_password@localhost:5433/ithina_dis_db
# Used by scripts/check_setup.sh probes.
POSTGRES_PORT=5433
POSTGRES_USER=ithina_dis_user
POSTGRES_DB=ithina_dis_db

# Pub/Sub emulator (docker-compose `pubsub`). Both consumers and dis-ui-server
# publish/pull through it; make topics-create provisions topics/subscriptions.
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=local-dis

# GCS emulator (docker-compose `gcs`, fake-gcs-server). GCS_BUCKET_BRONZE is
# required by dis-ui-server (CSV upload), csv-ingest-worker, and the connectors.
STORAGE_EMULATOR_HOST=http://localhost:4443
GCS_BUCKET_BRONZE=ithina-bronze-raw

# Redis (docker-compose `redis`); checked by scripts/check_setup.sh.
REDIS_URL=redis://localhost:6379

# Customer Master read access (mirror-sync DB-pull; role dis_mirror_reader).
# Local: CM's own devbox Postgres on 5432, separate from DIS Postgres on 5433.
CM_DB_URL=postgresql://dis_mirror_reader:dev-only-rotate-in-cloud@localhost:5432/ithina_platform_db
CM_DB_HOST=localhost
CM_DB_PORT=5432
CM_DB_NAME=ithina_platform_db

# Local fakes (docker-compose services).
IDENTITY_SERVICE_URL=http://localhost:8081
CUSTOMER_MASTER_URL=http://localhost:8082
