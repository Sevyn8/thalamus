# cm-frontend runtime env (real Auth0, the only auth path).
# Copy to .env.local for local dev; set the real values as runtime env on
# Cloud Run for a deploy. All are server-side (non-NEXT_PUBLIC_), read at
# request time.

# --- Auth0 (confidential server-side session, @auth0/nextjs-auth0 v4) ---
AUTH0_DOMAIN=sevyn8.us.auth0.com
AUTH0_CLIENT_ID=
# Secret Manager in a real deploy (confidential client secret).
AUTH0_CLIENT_SECRET=
# Session cookie encryption secret (Secret Manager in a real deploy).
# Generate with: openssl rand -hex 32
AUTH0_SECRET=
# The deployed app's own base URL (the CM frontend Cloud Run URL).
APP_BASE_URL=http://localhost:3000
# MANDATORY: mints cm-backend-valid access tokens (aud check). Without it
# Auth0 returns only an ID token.
AUTH0_AUDIENCE=https://api.sevyn8.com

# --- cm-backend (the API the BFF calls) ---
API_BASE_URL=https://cm-backend-mjiqp4br4a-el.a.run.app
