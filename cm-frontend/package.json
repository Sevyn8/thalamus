{
  "name": "admin-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/assert-dynamic-routes.mjs && node scripts/assert-no-em-dash.mjs && node scripts/assert-launcher-tiles.mjs",
    "start": "next start",
    "lint": "eslint",
    "gen:types": "openapi-typescript docs/openapi.json -o types/openapi-generated.ts",
    "gen:dis-types": "test -f docs/dis-openapi.json && openapi-typescript docs/dis-openapi.json -o types/dis-openapi-generated.ts || echo '[gen:dis-types] docs/dis-openapi.json missing; skipping (no-op)' >&2"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.19.0",
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "openapi-typescript": "^7.10.0",
    "shadcn": "^4.6.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10",
      "fast-uri": ">=3.1.2",
      "hono": ">=4.12.18",
      "ip-address": ">=10.1.1",
      "brace-expansion": "^2.0.2"
    }
  }
}