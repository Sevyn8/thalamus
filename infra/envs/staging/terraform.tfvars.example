# Copy to terraform.tfvars and adjust if needed. terraform.tfvars is gitignored;
# only this .example is tracked. The variables.tf defaults already carry these
# real values, so a terraform.tfvars is optional for staging; this file
# documents the full set and is the template production will diverge from.

project_id      = "sevyn8-thalamus-staging"
region          = "asia-south1"
zone            = "asia-south1-c"
org_id          = "395217984150"
billing_account = "016691-555E7E-B5AB24"

# state_prefix is documentation only; the real value is hardcoded in backend.tf
# (bucket = sevyn8-tfstate, prefix = thalamus/staging).
state_prefix = "thalamus/staging"

labels = {
  workload    = "thalamus"
  env         = "staging"
  cost_center = "sevyn8"
}

# --- Wave 1: network ---
name_prefix    = "thalamus"
subnet_cidr    = "10.20.0.0/24"
connector_cidr = "10.8.0.0/28"

# --- Wave 1: Cloud SQL (shared instance + shared database + three roles) ---
cloud_sql_instance_name       = "thalamus-pg"
database_name                 = "thalamus"
cloud_sql_tier                = "db-custom-1-3840"
cloud_sql_disk_size_gb        = 10
cloud_sql_availability_type   = "ZONAL"
cloud_sql_deletion_protection = true

# --- Wave 2: CM (cm-backend) Cloud Run service ---
cm_image = "asia-south1-docker.pkg.dev/sevyn8-thalamus-staging/thalamus-images/cm-backend:v1"

# APP_REGION is a CM residency bucket (EU|US|LOCAL), NOT the GCP region.
# asia-south1 is INVALID and crashes CM on boot. Confirm the intended bucket.
cm_app_region = "US"

# Lazy Auth0 values, not recorded in the repo. CM boots in AUTH0 mode without
# them; provisioning / invite-send / email-sync fail at run time until set.
cm_auth0_mgmt_client_id     = ""
cm_auth0_mgmt_db_connection = ""
cm_auth0_ticket_result_url  = ""

# --- Wave 3: DIS (dis-ui-server) Cloud Run service ---
dis_ui_server_image = "asia-south1-docker.pkg.dev/sevyn8-thalamus-staging/thalamus-images/dis-ui-server:v1"

# --- Wave 3: DIS (csv-ingest-worker) Cloud Run service ---
csv_ingest_worker_image = "asia-south1-docker.pkg.dev/sevyn8-thalamus-staging/thalamus-images/csv-ingest-worker:v1"
